# config-demo.mjs のための、環境変数の例（第26章 5節）
# このファイルは Git に入れてよい「見本」です。本物の値は .env に書き、.env は Git に入れません。
NODE_ENV=development
HOST=127.0.0.1
PORT=9334
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:5173, http://127.0.0.1:5173
# 開発用の値。本番では、その場で作った乱数を、サーバの設定画面などから渡す（第12部 第60章）
SESSION_SECRET=dev-only-session-secret-0123456789abcdef
