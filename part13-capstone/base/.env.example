# このファイルを .env にコピーして使う（.env はコミットしない）: cp .env.example .env
# npm start と npm run dev は、.env があれば読む（node --env-file-if-exists）
# ここに書く値は開発用。本物の秘密の値は、ここにもリポジトリにも書かない（第12部 第60章）

NODE_ENV=development
HOST=127.0.0.1
PORT=9900
# LOG_LEVEL=debug

RATE_LIMIT_PER_MINUTE=120
SHUTDOWN_DELAY_MS=0
SHUTDOWN_TIMEOUT_MS=10000

# データベース（このリポジトリの compose.yaml の PostgreSQL。先に docker compose up -d --wait）
# 無ければ、開発とテストでは下と同じものを使う。本番では必須（本物のパスワードは、ここにも書かない）
DATABASE_URL=postgres://app:dev-only-password@127.0.0.1:5434/roombooking
DATABASE_POOL_MAX=10

# ログイン
# 画面のオリジン（メールのリンクの頭。書き換えのリクエストは、このオリジンからだけ受け付ける）
APP_URL=http://localhost:5174
# 32 文字以上。無ければ、起動のたびに乱数で作る（起動し直すとログインはやり直し。本番では必須）
# SESSION_SECRET=dev-only-session-secret-change-me-00
SESSION_MAX_AGE_HOURS=168
LOGIN_RATE_LIMIT_PER_MINUTE=10
# メール（npm run mail で偽の SMTP サーバを動かしておく。届いたメールは http://127.0.0.1:8025/api/messages）
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM="Room Booking <no-reply@example.com>"
# 練習用の IdP でログイン（第54章）。使わないなら、3行とも書かない
# OIDC_ISSUER=http://127.0.0.1:9640
# OIDC_CLIENT_ID=room-app
# OIDC_CLIENT_SECRET=dev-only-client-secret

# Redis（このリポジトリの compose.yaml の Redis）。仕事の列に使う。本番では必須
REDIS_URL=redis://127.0.0.1:6381
# Redis のキーの頭。同じ Redis を、ほかのアプリと分けて使うため
QUEUE_PREFIX=rooms
# inline: このプロセスの中でワーカーも動かす（開発）。separate: npm run worker で別に動かす（本番）
WORKER_MODE=inline
# 前に立つプロキシの数（本番の PaaS では 1。第60章 7節）
TRUST_PROXY=0
# /metrics を読む合言葉（32 文字以上）。書かなければ、だれでも読める（本番では必須）
# METRICS_TOKEN=dev-only-metrics-token-change-me-000
# ビルドした画面（web/dist）を、この API で配るとき（第65章 6節）
# STATIC_DIR=web/dist
