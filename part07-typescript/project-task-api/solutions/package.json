{
  "name": "task-api",
  "version": "1.0.0",
  "description": "タスク管理 REST API（第7部の成果物。TypeScript で書き、データは PostgreSQL に置く）",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "migrate": "node --env-file-if-exists=.env src/db/migrate.ts",
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "node --test \"test/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "cors": "2.8.6",
    "express": "5.3.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "license": "MIT"
}
