{
  // 第7部の成果物の TypeScript の設定（第35章 8節・第37章の tsconfig.base.json と同じ中身）
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "types": ["node"],
    "moduleDetection": "force",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,

    // Node.js がそのまま動かせる書き方だけにする（node src/server.ts で動かすため）
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,

    // tsc は確かめるだけ（npm run typecheck）
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src", "test", "e2e", "scripts", "playwright.config.ts"]
}
