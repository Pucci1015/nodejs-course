# このファイルを .env にコピーして使う（.env はコミットしない）: cp .env.example .env
# npm start と npm run dev は、.env があれば読む（node --env-file-if-exists）
# ここに書く値は開発用。本物の秘密の値は、ここにもリポジトリにも書かない（第12部 第60章）

NODE_ENV=development
HOST=127.0.0.1
PORT=9490
# LOG_LEVEL=debug

# 第8部の画面（Vite）から呼ぶとき
CORS_ORIGINS=http://localhost:5173

# 32 文字以上。無ければ、起動のたびに乱数で作る（本番では必須）
# CURSOR_SECRET=dev-only-cursor-secret-change-me-0000

RATE_LIMIT_PER_MINUTE=120
MAX_DOING=3
SSE_HEARTBEAT_MS=15000
SHUTDOWN_DELAY_MS=0
SHUTDOWN_TIMEOUT_MS=10000

# 第6部: データベース（~/dev/part06 の compose.yaml の PostgreSQL。先に docker compose up -d --wait）
# 無ければ、開発とテストでは下と同じものを使う。本番では必須（本物のパスワードは、ここにも書かない）
DATABASE_URL=postgres://app:dev-only-password@127.0.0.1:5433/taskapi
DATABASE_POOL_MAX=10

# 第10部: ログイン
# 画面のオリジン（メールのリンクの頭。書き換えのリクエストは、このオリジンからだけ受け付ける）
APP_URL=http://localhost:5173
# 32 文字以上。無ければ、起動のたびに乱数で作る（起動し直すとログインはやり直し。本番では必須）
# SESSION_SECRET=dev-only-session-secret-change-me-00
SESSION_MAX_AGE_HOURS=168
LOGIN_RATE_LIMIT_PER_MINUTE=10
# メール（~/dev/part10 で npm run mail を動かしておく。第53章）
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM="Task App <no-reply@example.com>"
# 練習用の IdP でログイン（~/dev/part10 で npm run idp を動かしておく。第54章）。使わないなら、3行とも書かない
# OIDC_ISSUER=http://127.0.0.1:9640
# OIDC_CLIENT_ID=task-app
# OIDC_CLIENT_SECRET=dev-only-client-secret

# 第12部: 本番で動かすための設定（第60〜66章）
# Redis（~/dev/part06 の compose.yaml の Redis）。仕事の列と、SSE の知らせを全部の台に流すのに使う。本番では必須
REDIS_URL=redis://127.0.0.1:6380
# Redis のキーの頭。同じ Redis を、ほかのアプリと分けて使うため
QUEUE_PREFIX=taskapp
# inline: このプロセスの中でワーカーも動かす（開発）。separate: npm run worker で別に動かす（本番）
WORKER_MODE=inline
# 毎朝のお知らせ（今日が期限のタスク）を送る時刻と、日付を決めるタイムゾーン
DIGEST_CRON="0 8 * * *"
DIGEST_TZ=Asia/Tokyo
# 添付ファイルの置き場所（~/dev/part12 で npm run s3 を動かしておく。第63章）。本番では鍵が必須
S3_ENDPOINT=http://127.0.0.1:9800
S3_BUCKET=task-files
S3_ACCESS_KEY_ID=dev-only-access-key
S3_SECRET_ACCESS_KEY=dev-only-secret-key
ATTACHMENT_MAX_BYTES=5000000
ATTACHMENTS_PER_TASK=10
# 前に立つプロキシの数（本番の PaaS では 1。第60章 7節）
TRUST_PROXY=0
# /metrics を読む合言葉（32 文字以上）。書かなければ、だれでも読める（本番では必須）
# METRICS_TOKEN=dev-only-metrics-token-change-me-000
# ビルドした画面（web/dist）を、この API で配るとき（第65章 6節）
# STATIC_DIR=web/dist
