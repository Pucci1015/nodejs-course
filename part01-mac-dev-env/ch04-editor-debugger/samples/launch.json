// プロジェクトの .vscode/launch.json の例（第4章 10.4節）
// 「実行とデバッグ」の画面で設定を選び、F5 で開始する。
{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "今開いているファイルを実行",
      "program": "${file}",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "debug-demo.mjs を引数つきで実行",
      "program": "${workspaceFolder}/debug-demo.mjs",
      "args": ["3"],
      "env": { "DEBUG_DEMO": "1" },
      "skipFiles": ["<node_internals>/**"]
    },
    {
      // 既に node --inspect で起動しているプロセスに接続する
      "type": "node",
      "request": "attach",
      "name": "起動済みのプロセスに接続（9229番）",
      "port": 9229,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
